{
  "name": "@flop-tools/economic-runtime",
  "version": "0.3.0",
  "description": "Fail-closed economic execution layer for agent quotes, reservations, metering, settlement and reconciliation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flop-economic": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "settlement-action"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
